---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  # One StatefulSet per orderer node instance.
  name: {{ orderer_k8s_resource_name }}
  labels:
    app.kubernetes.io/name: {{ orderer_k8s_resource_name }}
    app.kubernetes.io/component: {{ orderer_component_type }}
    app.kubernetes.io/part-of: {{ orderer_k8s_part_of }}
spec:
  # Must match the headless Service name so DNS-based pod addressing works.
  serviceName: {{ orderer_k8s_resource_name }}
  # One replica per orderer node — horizontal scaling is done by adding nodes
  # to the Fabric network, not by scaling this pod.
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ orderer_k8s_resource_name }}
  template:
    metadata:
      labels:
        app.kubernetes.io/name: {{ orderer_k8s_resource_name }}
        app.kubernetes.io/component: {{ orderer_component_type }}
        app.kubernetes.io/part-of: {{ orderer_k8s_part_of }}
    spec:
      securityContext:
        # Ensures files mounted from Secrets and ConfigMaps are readable by
        # the orderer process running as a non-root user inside the container.
        fsGroup: {{ orderer_k8s_fs_group }}
      containers:
        - name: {{ orderer_component_type }}
          # Chaguar orderer image containing all component binaries.
          image: {{ orderer_image }}
{% if k8s_resources is defined and k8s_resources %}
          resources:
{{ k8s_resources | to_nice_yaml(indent=2) | indent(12, true) }}
{% endif %}
          args:
            - "{{ orderer_component_type }}"
            - --config={{ orderer_container_config_dir }}/node_config.yaml
          ports:
            - name: rpc
              # gRPC port used by Fabric peers and other orderer components.
              containerPort: {{ orderer_rpc_port }}
              protocol: TCP
            - name: metrics
              # Operations endpoint, including Prometheus metrics.
              containerPort: {{ orderer_operations_port }}
              protocol: TCP
          volumeMounts:
            # Crypto material and configuration, projected from the Secret and
            # ConfigMap into one read-only directory (see volumes below).
            - name: config
              mountPath: {{ orderer_container_config_dir }}
              readOnly: true
            # Persistent volume for ledger data and orderer state.
            - name: data
              mountPath: {{ orderer_container_data_dir }}
          readinessProbe:
            tcpSocket:
              port: rpc
            initialDelaySeconds: {{ k8s_readiness_probe_initial_delay_seconds | default(10) }}
            periodSeconds: {{ k8s_readiness_probe_period_seconds | default(10) }}
            timeoutSeconds: {{ k8s_readiness_probe_timeout_seconds | default(5) }}
            failureThreshold: {{ k8s_readiness_probe_failure_threshold | default(3) }}
            successThreshold: 1
          livenessProbe:
            tcpSocket:
              port: rpc
            initialDelaySeconds: {{ k8s_liveness_probe_initial_delay_seconds | default(30) }}
            periodSeconds: {{ k8s_liveness_probe_period_seconds | default(15) }}
            timeoutSeconds: {{ k8s_liveness_probe_timeout_seconds | default(5) }}
            failureThreshold: {{ k8s_liveness_probe_failure_threshold | default(5) }}
            successThreshold: 1
      volumes:
        - name: config
          # Projects the Secret (MSP identity, TLS keys) and the ConfigMap (node
          # config, genesis block, mTLS CAs) into one directory.
          projected:
            defaultMode: 0640
            sources:
              - secret:
                  name: {{ orderer_k8s_resource_name }}-secret
                  items:
                    - key: msp-keystore-priv-sk
                      path: msp/keystore/priv_sk
                    - key: msp-signcert.pem
                      path: msp/signcerts/cert.pem
{# Must match the cacerts path that secret.yaml.j2 writes into msp/config.yaml. #}
                    - key: msp-cacert.pem
                      path: msp/cacerts/ca.pem
                    - key: msp-config.yaml
                      path: msp/config.yaml
                    - key: tls-server.key
                      path: tls/server.key
                    - key: tls-server.crt
                      path: tls/server.crt
                    - key: tls-ca.crt
                      path: tls/ca.crt
              - configMap:
                  name: {{ orderer_k8s_resource_name }}-config
                  items:
                    - key: node-config.yaml
                      path: node_config.yaml
                    - key: genesis.block
                      path: genesis.block
{% for orderer_k8s_mtls_ca_name in orderer_k8s_mtls_ca_names %}
                    # mTLS CA trusted for client or organization {{ orderer_k8s_mtls_ca_name }}.
                    - key: mtls-{{ orderer_k8s_mtls_ca_name }}-ca.crt
                      path: mtls/{{ orderer_k8s_mtls_ca_name }}/ca.crt
{% endfor %}
{% if k8s_image_pull_secret is defined and k8s_image_pull_secret %}
      imagePullSecrets:
        # Secret used to pull the orderer image from a private registry.
        - name: {{ k8s_image_pull_secret }}
{% endif %}
  volumeClaimTemplates:
    # PVC name — Kubernetes appends the pod ordinal (e.g. data-<name>-0).
    - metadata:
        name: data
      spec:
        accessModes:
          # Each orderer pod owns its own volume; no sharing between replicas.
          - ReadWriteOnce
{% if k8s_storage_class is defined and k8s_storage_class %}
        storageClassName: {{ k8s_storage_class }}
{% endif %}
        resources:
          requests:
            storage: {{ k8s_storage_size }}
